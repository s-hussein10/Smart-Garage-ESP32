  {
    "id": "fn_build_log_record_pro",
    "type": "function",
    "z": "tab_smart_garage_pro",
    "name": "Format Excel CSV & Google Sheet Row",
    "func": "const s = flow.get('garage_state') || {};\nconst e = msg.payload || {};\nconst ts = new Date().toLocaleString();\nconst safety = (s.fl2 || s.fl3 || s.d2 || s.d3 || s.intrusion || s.masterAlarm) ? 'EMERGENCY' : 'SAFE';\nconst f1 = (e.f1_cars !== undefined) ? Number(e.f1_cars) : (s.f1 || 0);\nconst f2 = s.f2 || 0;\nconst f3 = s.f3 || 0;\nconst inside = f1 + f2 + f3;\n\nconst record = {\n  timestamp: ts,\n  action: e.action || 'EVENT',\n  truck_id: e.truck_id || 'CAR',\n  rfid: e.rfid || '---',\n  driver: e.driver || 'Unknown',\n  type: e.type || 'Vehicle',\n  f1_cars: f1,\n  f2_cars: f2,\n  f3_cars: f3,\n  total_inside: inside,\n  f2_temp: s.t2 || 0,\n  f2_hum: s.h2 || 0,\n  f2_smoke: s.s2 || 0,\n  f2_flame: s.fl2 ? 1 : 0,\n  f3_temp: s.t3 || 0,\n  f3_hum: s.h3 || 0,\n  f3_smoke: s.s3 || 0,\n  f3_flame: s.fl3 ? 1 : 0,\n  safety_status: safety\n};\n\n// CSV line for local Excel file\nconst csvLine = `\"${record.timestamp}\",\"${record.action}\",\"${record.truck_id}\",\"${record.rfid}\",\"${record.driver}\",\"${record.type}\",${record.f1_cars},${record.f2_cars},${record.f3_cars},${record.total_inside},${record.f2_temp},${record.f2_hum},${record.f2_smoke},\"${record.f2_flame ? 'FIRE' : 'SAFE'}\",${record.f3_temp},${record.f3_hum},${record.f3_smoke},\"${record.f3_flame ? 'FIRE' : 'SAFE'}\",\"${record.safety_status}\"`;\n\nreturn [\n  { payload: csvLine },\n  { payload: record }\n];",
    "outputs": 2,
    "x": 450,
    "y": 380,
    "wires": [
      ["file_excel_csv_pro"],
      ["fn_gsheet_url_pro"]
    ]
  },
  {
    "id": "file_excel_csv_pro",
    "type": "file",
    "z": "tab_smart_garage_pro",
    "name": "📊 Append Local Excel CSV",
    "filename": "D:\\storrge\\UNI\\SMART GARAGE proj\\garage_live_log.csv",
    "filenameType": "str",
    "appendNewline": true,
    "createDir": true,
    "overwriteFile": "false",
    "encoding": "utf8",
    "x": 760,
    "y": 350,
    "wires": [[]]
  },
  {
    "id": "fn_gsheet_url_pro",
    "type": "function",
    "z": "tab_smart_garage_pro",
    "name": "⚙️ Set Google Sheets URL",
    "func": "// PASTE YOUR GOOGLE APPS SCRIPT WEB APP URL BELOW:\nconst GOOGLE_SHEETS_WEBAPP_URL = \"https://script.google.com/macros/s/AKfycbzC-kHrrwcpk074xqur0AUxMxY9rkel48Y2OTWgOSyvJzjbz1NK1k1aUuzoH8td1IEhcg/exec\";\n\nif (!GOOGLE_SHEETS_WEBAPP_URL || GOOGLE_SHEETS_WEBAPP_URL.startsWith(\"PASTE_\")) {\n  // Not configured yet — skip HTTP request cleanly\n  return null;\n}\n\nmsg.url = GOOGLE_SHEETS_WEBAPP_URL;\nmsg.method = \"POST\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nreturn msg;",
    "outputs": 1,
    "x": 760,
    "y": 410,
    "wires": [["http_gsheet_post_pro"]]
  },
